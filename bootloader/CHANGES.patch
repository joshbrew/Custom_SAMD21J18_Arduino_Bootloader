+#if defined(BOARD_ID_custom_j18)
+/* Naked assembly: never access a C stack frame after switching the MSP. */
+void __attribute__((naked, noreturn, noinline, noclone, used, externally_visible))
+custom_enter_application(uint32_t vectors)
+{
+  __asm__ volatile(
+      "ldr r1, [r0, #0]\n"
+      "ldr r2, [r0, #4]\n"
+      "msr msp, r1\n"
+      "dsb\n"
+      "isb\n"
+      "cpsie i\n"
+      "bx r2\n");
+}
+#endif
+
 static void jump_to_application(void) {
+
+#if defined(BOARD_ID_custom_j18)
+  __disable_irq();
+  SCB->VTOR = (uint32_t)&__sketch_vectors_ptr;
+  __DSB();
+  __ISB();
+  custom_enter_application((uint32_t)&__sketch_vectors_ptr);
+#else
 
   /* Rebase the Stack Pointer */
   __set_MSP( (uint32_t)(__sketch_vectors_ptr) );
@@ -44,6 +72,7 @@
 
   /* Jump to application Reset Handler in the application */
   asm("bx %0"::"r"(*pulSketch_Start_Address));
+#endif
 }
 
